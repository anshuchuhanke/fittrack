# Postgres connection string (Railway provides this automatically when you add a Postgres plugin)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Long random string used to sign login sessions - generate with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# A secret you make up. You'll need to enter this once when creating your account,
# so strangers who find your app's URL can't sign themselves up.
SIGNUP_SECRET="pick-your-own-secret-phrase"

# Optional: enables AI-estimated nutrition for foods not in the preloaded database.
# Get one at https://console.anthropic.com/ - leave blank to disable AI lookup.
ANTHROPIC_API_KEY=""

NODE_ENV="production"
PORT=4000
